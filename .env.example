# ==========================================
# CẤU HÌNH DỰ ÁN VIỆT FIT (UNIFIED CONFIG)
# ==========================================

# 1. Cơ sở dữ liệu PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/viet_fit
DATABASE_USERNAME=viet_fit
DATABASE_PASSWORD=change-me
POSTGRES_DB=viet_fit

# 2. OpenWeather API Key (Thời tiết thực tế)
WEATHER_API_KEY=

# 3. Google Gemini AI API Key (Nếu để trống sẽ tự chạy rule engine dự phòng)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_TIMEOUT_S=30
AI_FORCE_FALLBACK=false

# 4. Địa chỉ dịch vụ nội bộ
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176

# 5. Nguồn dữ liệu của AI: json (mặc định, tệp trong ai-service/data) hoặc postgres (đọc từ database của backend)
AI_CATALOG_SOURCE=json
