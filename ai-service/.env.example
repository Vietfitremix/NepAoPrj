# Để trống GEMINI_API_KEY thì service tự chạy nhánh dự phòng (không gọi Gemini)
GEMINI_API_KEY=
# Giữ đúng model đã cấu hình, không tự chuyển sang model khác.
GEMINI_MODEL=gemini-3.5-flash
# Cho phép phản hồi có đủ catalog và nội dung văn hóa; backend chờ tối đa 45 s.
AI_TIMEOUT_S=30
# true = giả lập Gemini lỗi để thử nhánh dự phòng
AI_FORCE_FALLBACK=false
# Đặt 0 để tắt "thinking" (nếu model hỗ trợ) cho phản hồi nhanh; để trống = mặc định của model
AI_THINKING_BUDGET=0

# Để trống = đọc catalog từ data/*.json và lưu cache trong bộ nhớ (chạy local không cần Postgres)
# Có giá trị = đọc catalog từ schema catalog, ghi ai.ai_cache và ai.ai_calls (xem PLAN-DEV mục 4)
DATABASE_URL=

# Read all AI catalog, quiz, scoring, checklist and prompts from Spring's database.
# PostgreSQL URI (never a jdbc: URL); percent-encode credentials if needed.
CATALOG_DATABASE_URL=

# When CATALOG_DATABASE_URL is set, both Spring integration and native APIs read the database.
# Otherwise true enables only the Spring bridge; standalone scoring uses data/scoring.json.
BACKEND_COMPAT_ONLY=true
# DATABASE_URL=postgresql://ai_user:matkhau@localhost:5432/nepao

ADMIN_TOKEN=dev-admin-token
# true chỉ khi chạy local: bật /ai/dev/* và /ai/playground
ENABLE_DEV_ROUTES=true
RATE_LIMIT_PER_MIN=10
